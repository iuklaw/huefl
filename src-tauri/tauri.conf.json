{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HueFL",
  "version": "0.1.3",
  "identifier": "dev.iuklaw.huefl",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HueFL",
        "width": 420,
        "height": 720,
        "minWidth": 380,
        "minHeight": 520,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "libpulse.so.0()(64bit)",
          "libpulse-simple.so.0()(64bit)",
          "libpipewire-0.3.so.0()(64bit)",
          "libssl.so.3()(64bit)"
        ]
      }
    },
    "category": "Utility",
    "shortDescription": "Unofficial light control and sync for Philips Hue",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1MTlEMkQzQ0NFODU4MEMKUldRTVdPak0wOUlaaFd3QzAwZ3BZY20yTUZCQnkzdWI3dUlnWUdBRGthaktybjA5VFlNb3hOQksK",
      "endpoints": [
        "https://github.com/iuklaw/huefl/releases/latest/download/latest.json"
      ]
    }
  }
}
